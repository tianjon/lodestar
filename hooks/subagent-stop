#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=hooks/lib.sh
source "$SCRIPT_DIR/lib.sh"

root="$(project_root)"

if [ ! -d "$root/.lodestar" ]; then
  exit 0
fi

emit_handoff_continuation "Before returning, ensure your report includes material state, evidence, decision, gap/question, and next-action updates for the parent. If already included, finish. Do not overwrite shared .lodestar/ files unless the parent explicitly assigned ownership. This feedback is for the subagent, not the parent."
