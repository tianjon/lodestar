#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=hooks/lib.sh
source "$SCRIPT_DIR/lib.sh"

root="$(project_root)"

if [ ! -d "$root/.lodestar" ]; then
  exit 0
fi

emit_handoff_continuation "Before ending, check whether material goal, boundary, decision, evidence, open gap/question, next-action, or re-anchor proposal changes still need saving in .lodestar/. Save only missing changes, with sensitive values redacted. If already current, finish without rewriting files. This is a single handoff pass, not a new task or a reason to expand scope."
