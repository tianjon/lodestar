# dashboard.awk: render the <body> of dashboard.html from lodestar-plan records.
# Input: tab-separated records from `collect` (+ "A key value" Anchor records).
# Variables: project, generated, base (link prefix), lang (zh|en).
# Runs with LC_ALL=C after the shared AWK_LIB; text is escaped, never truncated.

BEGIN {
  TAB = "\t"; US = "\037"
  if (lang == "en") en_labels(); else zh_labels()
}

