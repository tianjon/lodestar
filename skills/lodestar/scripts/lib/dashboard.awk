function lab(k) { return (k in L) ? L[k] : k }
function st(s) { return (("st_" s) in L) ? L["st_" s] : s }
function esc(s) {
  gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s)
  return s
}
function href(f,    s) {
  s = base f
  gsub(/%/, "%25", s); gsub(/ /, "%20", s); gsub(/#/, "%23", s); gsub(/\?/, "%3F", s)
  return esc(s)
}
function real(v) { return v != "" && v !~ /^<.*>$/ }
function field(fields, key,    n, parts, i, p) {
  n = split(fields, parts, US)
  for (i = 1; i <= n; i++) {
    p = index(parts[i], "=")
    if (substr(parts[i], 1, p - 1) == key) return substr(parts[i], p + 1)
  }
  return ""
}
function prefix_of(id,    p) { p = id; sub(/-.*/, "", p); return p }
function pill(s) { return "<span class=\"pill\">" esc(st(s == "" ? "-" : s)) "</span>" }
function link(file, text) { return "<a href=\"" href(file) "\">" esc(text) "</a>" }
function kvline(fields, keys,    n, k, i, v, out) {
  n = split(keys, k, " ")
  out = ""
  for (i = 1; i <= n; i++) {
    v = field(fields, k[i])
    if (real(v)) out = out "<div class=\"kv\"><b>" esc(lab(k[i])) "</b> " esc(v) "</div>"
  }
  return out
}
function fact(label, value) {
  if (real(value)) { printf "<dt>%s</dt><dd>%s</dd>\n", esc(label), esc(value); facts++ }
}
function tile(label, value, detail) {
  printf "<div class=\"card tile\"><div class=\"label\">%s</div><div class=\"value\">%d</div><div class=\"sub\">%s</div></div>\n", esc(label), value, detail
}
function sev(v,    c) {
  c = tolower(v)
  if (c != "high" && c != "medium" && c != "low") return real(v) ? "<span class=\"pill\">" esc(v) "</span>" : ""
  return "<span class=\"sev " c "\"><i aria-hidden=\"true\"></i>" esc(lab("sev-" c)) "</span>"
}

$1 == "M" { profile = $3; next }
$1 == "T" { title = $3; next }
$1 == "P" { pf[$3] = $4; next }
$1 == "A" { an[$2] = $3; has_anchor = 1; next }
$1 == "I" {
  n = ++n_items
  i_file[n] = $2; i_id[n] = $3; i_title[n] = $4; i_status[n] = $5; i_fields[n] = $6
  p = prefix_of($3); cnt[p, $5]++; tot[p]++
  next
}
$1 == "S" {
  n = ++n_specs
  s_file[n] = $2; s_id[n] = $3; s_title[n] = $4; s_status[n] = $5; s_fields[n] = $6
  scnt[$5]++
  next
}
$1 == "Q" { if ($3 == "open") { n = ++n_q; q_file[n] = $2; q_text[n] = $4; qby[$2]++ }; next }
$1 == "X" { sup[$3] = sup[$3] "<div class=\"kv\"><b>" esc(lab("supplement")) "</b> " esc($4) "</div>"; next }
$1 == "G" { n = ++n_g; g_term[n] = $3; g_mean[n] = $4; next }
$1 == "C" { n = ++n_c; c_file[n] = $2; c_title[n] = $3; c_resp[n] = $4; next }

END {
  writing = (profile == "writing")
  print "<div class=\"wrap\">"
  header(); focus(); kpis(); roadmap(); specs(); board(); decisions(); risks(); questions()
  if (writing) sources(); else domain()
  printf "<footer>%s</footer>\n</div>\n</body>\n</html>\n", esc(lab("footer"))
}

function header() {
  print "<header class=\"top\">"
  printf "<h1>%s</h1>\n<div class=\"meta\">", esc(real(title) ? title : project)
  printf "<span class=\"chip\">%s</span>", esc(lab("profile-" profile))
  if (real(pf["phase"])) printf "<span class=\"chip\">%s: %s</span>", esc(lab("phase")), esc(pf["phase"])
  if (real(pf["subject"])) printf "<span class=\"chip\">%s: %s</span>", esc(lab("subject")), esc(pf["subject"])
  printf "<span class=\"chip\">%s %s</span></div>\n</header>\n", esc(lab("generated")), esc(generated)
}

function focus() {
  printf "<section class=\"card\" aria-labelledby=\"focus\"><h2 id=\"focus\">%s</h2>\n<dl class=\"facts\">\n", esc(lab("focus"))
  facts = 0
  fact(lab("goal"), an["goal"]); fact(lab("mode"), an["mode"]); fact(lab("done-when"), an["done-when"])
  fact(lab("action"), an["action"]); fact(lab("return-stack"), an["return-stack"])
  fact(lab("plan-focus"), pf["focus"]); fact(lab("phase"), pf["phase"]); fact(lab("blueprint"), pf["blueprint"])
  fact(lab("constraints"), pf["constraints"]); fact(lab("audience"), pf["audience"]); fact(lab("channel"), pf["channel"])
  print "</dl>"
  if (!facts) printf "<p class=\"empty\">%s</p>\n", esc(lab("empty"))
  if (has_anchor) printf "<p class=\"note\">%s</p>\n", esc(lab("private"))
  print "</section>"
}

function kpis(    ideas_active, specs_active, risks_open, high, overrides, i, files, seen) {
  ideas_active = tot["IDEA"] - cnt["IDEA", "rejected"]
  specs_active = n_specs - scnt["dropped"]
  for (i = 1; i <= n_items; i++) {
    if (prefix_of(i_id[i]) == "RISK" && (i_status[i] == "open" || i_status[i] == "mitigating" || i_status[i] == "")) {
      risks_open++
      if (tolower(field(i_fields[i], "impact")) == "high") high++
    }
    if (prefix_of(i_id[i]) == "DEC" && field(i_fields[i], "override") == "user") overrides++
  }
  for (i = 1; i <= n_q; i++) if (!(q_file[i] in seen)) { seen[q_file[i]] = 1; files++ }
  print "<section class=\"kpis\" aria-label=\"KPI\">"
  tile(lab("ideas"), ideas_active, esc(st("inbox")) " " (cnt["IDEA", "inbox"] + 0) " · " esc(st("exploring")) " " (cnt["IDEA", "exploring"] + 0))
  tile(lab(writing ? "specs-writing" : "specs-software"), specs_active, esc(st("ready")) " " (scnt["ready"] + 0) " · " esc(st("in-progress")) " " (scnt["in-progress"] + scnt["handed-off"]) " · " esc(st("done")) " " (scnt["done"] + 0))
  tile(lab("questions"), n_q, (files + 0) " " esc(lab("files")))
  tile(lab("risks"), risks_open, esc(lab("high")) " " (high + 0))
  tile(lab("decisions"), tot["DEC"] + 0, esc(lab("overrides")) " " (overrides + 0))
  print "</section>"
}

function spec_line(j) {
  return "<li class=\"row\"><span class=\"id\">" esc(s_id[j]) "</span> " link(s_file[j], s_title[j]) " " pill(s_status[j]) "</li>"
}

function roadmap(    i, j, ms, done, total, any, assigned, pct, lines) {
  printf "<section class=\"card\" aria-labelledby=\"roadmap\"><h2 id=\"roadmap\">%s<span class=\"count\">%d</span></h2>\n", esc(lab("roadmap")), tot["MS"]
  for (i = 1; i <= n_items; i++) {
    if (prefix_of(i_id[i]) != "MS") continue
    ms = i_id[i]; done = 0; total = 0; lines = ""; any = 1
    for (j = 1; j <= n_specs; j++) {
      if (field(s_fields[j], "milestone") != ms) continue
      assigned[j] = 1
      lines = lines spec_line(j) "\n"
      if (s_status[j] == "dropped") continue
      total++
      if (s_status[j] == "done") done++
    }
    print "<div class=\"ms\"><div class=\"row\">"
    printf "<span class=\"id\">%s</span> <strong>%s</strong> %s", esc(ms), link(i_file[i], i_title[i]), pill(i_status[i])
    if (real(field(i_fields[i], "target"))) printf " <span class=\"pill\">%s %s</span>", esc(lab("target")), esc(field(i_fields[i], "target"))
    print "</div>"
    if (real(field(i_fields[i], "done-when"))) printf "<div class=\"kv\"><b>%s</b> %s</div>\n", esc(lab("done-when")), esc(field(i_fields[i], "done-when"))
    if (total > 0) {
      pct = int(done * 100 / total)
      printf "<div class=\"meter\" role=\"img\" aria-label=\"%d / %d\"><span style=\"width: %d%%\"></span></div><div class=\"kv\">%d / %d %s</div>\n", done, total, pct, done, total, esc(lab("done-of"))
    }
    if (lines != "") printf "<ul class=\"plain\">\n%s</ul>\n", lines
    else printf "<p class=\"empty\">%s</p>\n", esc(lab("no-specs"))
    print "</div>"
  }
  lines = ""
  for (j = 1; j <= n_specs; j++) if (!(j in assigned)) lines = lines spec_line(j) "\n"
  if (lines != "") { any = 1; printf "<div class=\"ms\"><h3>%s</h3><ul class=\"plain\">\n%s</ul></div>\n", esc(lab("unassigned")), lines }
  if (!any) printf "<p class=\"empty\">%s</p>\n", esc(lab("empty"))
  print "</section>"
}

function specs(    j, extra, v) {
  printf "<section class=\"card\" aria-labelledby=\"specs\"><h2 id=\"specs\">%s<span class=\"count\">%d</span></h2>\n", esc(lab(writing ? "specs-writing" : "specs-software")), n_specs
  if (!n_specs) { printf "<p class=\"empty\">%s</p></section>\n", esc(lab("empty")); return }
  extra = writing ? "deadline" : "priority"
  printf "<div class=\"scroll\"><table><thead><tr><th>%s</th><th>%s</th><th>%s</th><th>%s</th><th>%s</th><th>%s</th><th>%s</th></tr></thead><tbody>\n", esc(lab("id")), esc(lab("title")), esc(lab("status")), esc(lab(extra)), esc(lab("milestone")), esc(lab("owner")), esc(lab("open-q"))
  for (j = 1; j <= n_specs; j++) {
    printf "<tr><td class=\"id\">%s</td><td>%s</td><td>%s</td>", esc(s_id[j]), link(s_file[j], s_title[j]), pill(s_status[j])
    v = field(s_fields[j], extra); printf "<td>%s</td>", real(v) ? esc(v) : "—"
    v = field(s_fields[j], "milestone"); printf "<td>%s</td>", real(v) ? esc(v) : "—"
    v = field(s_fields[j], "owner"); printf "<td>%s</td>", real(v) ? esc(v) : "—"
    printf "<td class=\"num\">%d</td></tr>\n", qby[s_file[j]] + 0
  }
  print "</tbody></table></div></section>"
}

function idea_card(i) {
  return "<div class=\"item\"><div class=\"row\"><span class=\"id\">" esc(i_id[i]) "</span></div><div class=\"t\">" link(i_file[i], i_title[i]) "</div>" kvline(i_fields[i], "next to why tags src") sup[i_id[i]] "</div>"
}

function board(    cols, n, c, i, html, count, rejected, nrej) {
  printf "<section class=\"card\" aria-labelledby=\"board\"><h2 id=\"board\">%s<span class=\"count\">%d</span></h2>\n", esc(lab("board")), tot["IDEA"]
  if (!tot["IDEA"]) { printf "<p class=\"empty\">%s</p></section>\n", esc(lab("empty")); return }
  n = split("inbox exploring adopted parked", cols, " ")
  print "<div class=\"board\">"
  for (c = 1; c <= n; c++) {
    html = ""; count = 0
    # Newest first; unknown statuses stay visible in the first column.
    for (i = n_items; i >= 1; i--) {
      if (prefix_of(i_id[i]) != "IDEA") continue
      if (i_status[i] == cols[c] || (c == 1 && i_status[i] !~ /^(inbox|exploring|adopted|parked|rejected)$/)) {
        html = html idea_card(i) "\n"; count++
      }
    }
    printf "<div class=\"col\"><h3>%s · %d</h3>\n%s</div>\n", esc(st(cols[c])), count, html
  }
  print "</div>"
  rejected = ""; nrej = 0
  for (i = n_items; i >= 1; i--) {
    if (prefix_of(i_id[i]) == "IDEA" && i_status[i] == "rejected") {
      nrej++
      rejected = rejected "<li><span class=\"id\">" esc(i_id[i]) "</span> " link(i_file[i], i_title[i]) kvline(i_fields[i], "why") "</li>\n"
    }
  }
  if (nrej) printf "<details><summary>%s · %d</summary><ul class=\"plain\">\n%s</ul></details>\n", esc(lab("rejected")), nrej, rejected
  print "</section>"
}

function decisions(    i, any) {
  printf "<section class=\"card\" aria-labelledby=\"decisions\"><h2 id=\"decisions\">%s<span class=\"count\">%d</span></h2>\n", esc(lab("decisions-h")), tot["DEC"]
  for (i = n_items; i >= 1; i--) {
    if (prefix_of(i_id[i]) != "DEC") continue
    any = 1
    printf "<div class=\"item\"><div class=\"row\"><span class=\"id\">%s</span> %s", esc(i_id[i]), pill(i_status[i])
    if (field(i_fields[i], "override") == "user") printf " <span class=\"flag\">⚑ %s</span>", esc(lab("override"))
    printf "</div><div class=\"t\">%s</div>%s</div>\n", link(i_file[i], i_title[i]), kvline(i_fields[i], "why challenge compensation revisit options supersedes")
  }
  if (!any) printf "<p class=\"empty\">%s</p>\n", esc(lab("empty"))
  print "</section>"
}

function risks(    i, s, any, closed, nclosed, kind) {
  printf "<section class=\"card\" aria-labelledby=\"risks\"><h2 id=\"risks\">%s<span class=\"count\">%d</span></h2>\n", esc(lab("risks-h")), tot["RISK"]
  closed = ""; nclosed = 0
  for (i = 1; i <= n_items; i++) {
    if (prefix_of(i_id[i]) != "RISK") continue
    s = i_status[i]
    kind = field(i_fields[i], "kind")
    if (s == "closed" || s == "accepted") {
      nclosed++
      closed = closed "<li class=\"row\"><span class=\"id\">" esc(i_id[i]) "</span> " link(i_file[i], i_title[i]) " " pill(s) "</li>\n"
      continue
    }
    any = 1
    printf "<div class=\"item\"><div class=\"row\"><span class=\"id\">%s</span> %s %s", esc(i_id[i]), pill(s), sev(field(i_fields[i], "impact"))
    if (real(kind)) printf " <span class=\"pill\">%s</span>", esc(lab("kind-" kind))
    printf "</div><div class=\"t\">%s</div>%s</div>\n", link(i_file[i], i_title[i]), kvline(i_fields[i], "signal mitigation from")
  }
  if (!any && !nclosed) printf "<p class=\"empty\">%s</p>\n", esc(lab("empty"))
  if (nclosed) printf "<details><summary>%s · %d</summary><ul class=\"plain\">\n%s</ul></details>\n", esc(lab("closed")), nclosed, closed
  print "</section>"
}

function questions(    i) {
  printf "<section class=\"card\" aria-labelledby=\"questions\"><h2 id=\"questions\">%s<span class=\"count\">%d</span></h2>\n", esc(lab("questions-h")), n_q
  if (!n_q) { printf "<p class=\"empty\">%s</p></section>\n", esc(lab("empty")); return }
  print "<ul class=\"plain\">"
  for (i = 1; i <= n_q; i++) printf "<li>%s <span class=\"id\">%s</span></li>\n", esc(q_text[i]), link(q_file[i], q_file[i])
  print "</ul></section>"
}

function domain(    i) {
  printf "<section class=\"grid2\"><div class=\"card\"><h2>%s<span class=\"count\">%d</span></h2>\n", esc(lab("contexts")), n_c
  if (!n_c) printf "<p class=\"empty\">%s</p>\n", esc(lab("empty"))
  else {
    print "<ul class=\"plain\">"
    for (i = 1; i <= n_c; i++) printf "<li>%s%s</li>\n", link(c_file[i], c_title[i]), real(c_resp[i]) ? "<div class=\"kv\">" esc(c_resp[i]) "</div>" : ""
    print "</ul>"
  }
  printf "</div><div class=\"card\"><h2>%s<span class=\"count\">%d</span></h2>\n", esc(lab("glossary")), n_g
  if (!n_g) printf "<p class=\"empty\">%s</p>\n", esc(lab("empty"))
  else {
    print "<dl class=\"facts\">"
    for (i = 1; i <= n_g; i++) printf "<dt>%s</dt><dd>%s</dd>\n", esc(g_term[i]), esc(g_mean[i])
    print "</dl>"
  }
  print "</div></section>"
}

function sources(    i, any) {
  printf "<section class=\"card\" aria-labelledby=\"sources\"><h2 id=\"sources\">%s<span class=\"count\">%d</span></h2>\n", esc(lab("sources-h")), tot["SRC"]
  for (i = 1; i <= n_items; i++) {
    if (prefix_of(i_id[i]) != "SRC") continue
    if (!any) printf "<div class=\"scroll\"><table><thead><tr><th>%s</th><th>%s</th><th>%s</th><th>%s</th><th>%s</th></tr></thead><tbody>\n", esc(lab("id")), esc(lab("title")), esc(lab("status")), esc(lab("reliability")), esc(lab("used-in"))
    any = 1
    printf "<tr><td class=\"id\">%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>\n", esc(i_id[i]), link(i_file[i], i_title[i]), pill(i_status[i]), sev(field(i_fields[i], "reliability")), real(field(i_fields[i], "used-in")) ? esc(field(i_fields[i], "used-in")) : "—"
  }
  if (any) print "</tbody></table></div>"
  else printf "<p class=\"empty\">%s</p>\n", esc(lab("empty"))
  printf "<p class=\"note\">%s</p></section>\n", link("style.md", lab("style"))
}
